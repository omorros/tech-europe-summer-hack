# Copy to backend/.env and fill in. Never commit .env.

# Google Cloud key with BILLING ENABLED and these APIs on:
# Geocoding API, Street View Static API, Maps Static API
GOOGLE_MAPS_API_KEY=

# OpenAI (hackathon credits arrive by email via Luma)
OPENAI_API_KEY=

# Portal-H key from H Company (portal.hcompany.ai)
HAI_API_KEY=

# fal key, voucher techeuropexfal-london redeemed on the billing page
FAL_KEY=

# EPC open data register (epc.opendatacommunities.org): the email you
# registered with plus the API key they show you
EPC_EMAIL=
EPC_API_KEY=

# ---------------------------------------------------------------------------
# Bill's lane: extraction, route planning, briefing
# ---------------------------------------------------------------------------

# pioneer.ai > Settings > API Keys. Shown once at creation; starts with pio_sk_.
PIONEER_API_KEY=
# Set to the training-job UUID after the fine-tune completes — this one line
# swaps the console from zero-shot GLiNER2 to our fine-tuned checkpoint.
PIONEER_MODEL_ID=
# Briefing-script model (Gemma 4 on Pioneer). SIZEUP_BRIEFING_LLM=off falls
# back to the deterministic template.
PIONEER_BRIEFING_MODEL=google/gemma-4-31B-it
SIZEUP_BRIEFING_LLM=on

# Walkthrough video (entrance -> seat of fire) via the Cloudflare Worker in
# worker/. The Worker holds its own FAL_KEY; we only need its URL and token.
SIZEUP_WORKER_URL=
SIZEUP_WORKER_TOKEN=

# FastAPI (uv run uvicorn server:app --host 0.0.0.0 --port 8000)
# The browser never needs these; the frontend talks to this process over
# HTTP + WebSocket. When the UI is on Cloudflare, expose this with
# `cloudflared tunnel --url http://localhost:8000` and put that https URL
# in the Worker BACKEND_ORIGIN var (or ?backend= on the landing page).
#
# uvicorn only serves WebSockets if a ws implementation is installed. The
# `websockets` package arrives through uv.lock today, but as a transitive
# dependency rather than one we declare. If /ws/console ever answers
# "Unsupported upgrade request", that is what went missing: `uv add websockets`.

# Talking head in the corner of the walkthrough. Team decision: OFF — a crew
# riding to a job cannot hear narration over the sirens, so the briefing is
# on-screen text (`lines` on briefing.ready). Costs nothing, needs no keys.
#   off     text crew card only. Default.
#   avatar  veed/avatars/text-to-video, ~$0.18, voice included, no portrait.
#   fabric  Kokoro TTS then VEED Fabric 1.0 onto your own portrait, ~$2.40.
SIZEUP_BUBBLE_MODE=off
SIZEUP_AVATAR_ID=emily_primary
SIZEUP_AVATAR_URL=
SIZEUP_FAL_RESOLUTION=480p
SIZEUP_TTS_VOICE=am_michael
# Our share of the $25 voucher — renders refuse past this. Agree the split
# with Oriol at the 12:00 checkpoint.
SIZEUP_FAL_BUDGET_USD=12.50
